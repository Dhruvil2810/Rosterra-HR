@model ROSTERRA_HR.Models.Payroll

@{
    ViewBag.Title = "My Payslip - " + Model.MonthName;
}

<div class="container py-4" style="max-width: 800px;">
    <!-- Print Toolbar (Hidden during actual print) -->
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <a href="@Url.Action("Index", "EmployeePayroll")" class="btn btn-outline-secondary btn-sm">
            &larr; Back to Payslip List
        </a>
        <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
            &#128438; Print / Save as PDF
        </button>
    </div>

    <!-- Official Payslip Document -->
    <div class="card shadow border p-4 bg-white">
        <!-- Company Header -->
        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
            <div>
                <h3 class="fw-bold text-primary mb-1">ROSTERRA HR</h3>
                <p class="text-muted small mb-0">Human Resources &amp; Workforce Management Systems</p>
                <div class="small text-muted">Corporate Office: Tech Park, Floor 4, Suite 100</div>
            </div>
            <div class="text-end">
                <div class="fs-4 fw-bold text-dark text-uppercase">Payslip</div>
                <div class="fw-semibold text-primary">@Model.MonthName</div>
                <span class="badge @(Model.Status == "Paid" ? "bg-success" : "bg-warning text-dark")">@Model.Status</span>
            </div>
        </div>

        <!-- Employee Info Grid -->
        <div class="row g-3 mb-4 p-3 bg-light rounded border">
            <div class="col-6 col-md-3">
                <small class="text-muted d-block">Employee Name</small>
                <strong>@Model.EmployeeName</strong>
            </div>
            <div class="col-6 col-md-3">
                <small class="text-muted d-block">Department</small>
                <span>@Model.Department</span>
            </div>
            <div class="col-6 col-md-3">
                <small class="text-muted d-block">Designation</small>
                <span>@Model.Position</span>
            </div>
            <div class="col-6 col-md-3">
                <small class="text-muted d-block">Disbursal Date</small>
                <span>@Model.FormattedPaymentDate</span>
            </div>
        </div>

        <!-- Attendance Summary Banner -->
        <div class="alert alert-secondary py-2 small mb-4">
            <strong>Attendance Metric:</strong> 
            Total Working Days: <strong>@Model.TotalWorkingDays</strong> &bull; 
            Present / Paid: <strong class="text-success">@Model.PresentDays</strong> &bull; 
            Absent / LOP: <strong class="text-danger">@Model.AbsentDays</strong>
            <span class="text-muted ms-1">(Sundays excluded)</span>
        </div>

        <!-- Earnings and Deductions Two-Column Table -->
        <div class="row g-4 mb-4">
            <!-- Earnings -->
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <h6 class="fw-bold text-success border-bottom pb-2 mb-3">Earnings (Gross)</h6>
                    <div class="d-flex justify-content-between py-1 small">
                        <span>Basic Salary</span>
                        <strong>@Model.BasicSalary.ToString("C")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 small border-top">
                        <span>Allowances (HRA / Special)</span>
                        <strong>@Model.Allowances.ToString("C")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 mt-3 border-top border-2 fw-bold text-dark">
                        <span>Total Gross Earnings</span>
                        <span>@Model.GrossSalary.ToString("C")</span>
                    </div>
                </div>
            </div>

            <!-- Deductions -->
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <h6 class="fw-bold text-danger border-bottom pb-2 mb-3">Deductions</h6>
                    <div class="d-flex justify-content-between py-1 small">
                        <span>Standard Deductions (Tax/PF)</span>
                        <strong>@Model.StandardDeductions.ToString("C")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 small border-top">
                        <span>Loss of Pay (LOP for @Model.AbsentDays absent days)</span>
                        <strong class="text-danger">@Model.LossOfPay.ToString("C")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 mt-3 border-top border-2 fw-bold text-danger">
                        <span>Total Deductions</span>
                        <span>@((Model.StandardDeductions + Model.LossOfPay).ToString("C"))</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Net Take-Home Highlight -->
        <div class="p-3 bg-primary bg-opacity-10 rounded border border-primary text-center mb-4">
            <div class="small text-muted text-uppercase fw-semibold">Net Take-Home Salary</div>
            <div class="display-6 fw-bold text-primary">@Model.NetSalary.ToString("C")</div>
        </div>

        <!-- Signatures & Disclaimer Footer -->
        <div class="d-flex justify-content-between align-items-end pt-4 mt-3 border-top text-muted small">
            <div>
                <div>Generated By: <strong>@(Model.GeneratedByUsername ?? "System Administrator")</strong></div>
                <div>Generated On: @Model.CreatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</div>
            </div>
            <div class="text-end">
                <div class="border-top pt-2 px-4 text-center">
                    Authorized Signatory &bull; HR Department
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .d-print-none { display: none !important; }
        body { background: white !important; }
        .card { box-shadow: none !important; border: 1px solid #ddd !important; }
    }
</style>
