@model ROSTERRA_HR.Models.HRLeaveManageViewModel

@{
    ViewBag.Title = "Employee Leave Requests";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h2 class="h3 fw-bold mb-1 text-dark">Leave Management</h2>
            <p class="text-muted mb-0 small">Review, verify, and approve or reject employee leave applications.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Attendance")" class="btn btn-outline-primary btn-sm">
                &#128197; Attendance Monitor
            </a>
            <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary btn-sm">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>&#10004; Success:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>&#9888; Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-primary">
                <div class="text-muted small">Total Requests</div>
                <div class="h3 fw-bold text-dark mb-0">@Model.TotalRequests</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-warning">
                <div class="text-muted small">Pending Approval</div>
                <div class="h3 fw-bold text-warning mb-0">@Model.PendingRequests</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-success">
                <div class="text-muted small">Approved</div>
                <div class="h3 fw-bold text-success mb-0">@Model.ApprovedRequests</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-danger">
                <div class="text-muted small">Rejected</div>
                <div class="h3 fw-bold text-danger mb-0">@Model.RejectedRequests</div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card border-0 shadow-sm bg-white mb-4">
        <div class="card-body p-3">
            <form method="get" action="@Url.Action("Index", "Leave")" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Status Filter</label>
                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="All" @(Model.FilterStatus == "All" ? "selected" : "")>All Requests</option>
                        <option value="Pending" @(Model.FilterStatus == "Pending" ? "selected" : "")>Pending Only</option>
                        <option value="Approved" @(Model.FilterStatus == "Approved" ? "selected" : "")>Approved Only</option>
                        <option value="Rejected" @(Model.FilterStatus == "Rejected" ? "selected" : "")>Rejected Only</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small text-muted mb-1">Search Employee / Reason</label>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Search by name, department, or reason..." />
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
                    <a href="@Url.Action("Index", "Leave")" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Leave Requests Table -->
    <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Leave Type</th>
                            <th>Date Range</th>
                            <th>Working Days</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LeaveRequests != null && Model.LeaveRequests.Any())
                        {
                            foreach (var leave in Model.LeaveRequests)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@leave.EmployeeName</div>
                                        <span class="small text-muted">Applied: @leave.FormattedCreatedAt</span>
                                    </td>
                                    <td>@leave.Department</td>
                                    <td><span class="badge bg-light text-dark border">@leave.LeaveType</span></td>
                                    <td>
                                        <div class="fw-semibold">@leave.FormattedStartDate &rarr; @leave.FormattedEndDate</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@leave.TotalDays working day(s)</span>
                                        <div class="small text-muted" style="font-size: 0.75rem;">Sundays excluded</div>
                                    </td>
                                    <td style="max-width: 250px;">
                                        <span class="text-truncate d-inline-block" style="max-width: 240px;" title="@leave.Reason">
                                            @leave.Reason
                                        </span>
                                    </td>
                                    <td>
                                        @if (leave.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (leave.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                            if (!string.IsNullOrEmpty(leave.AdminRemarks))
                                            {
                                                <div class="small text-muted" style="font-size: 0.75rem;">Remarks: @leave.AdminRemarks</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                            if (!string.IsNullOrEmpty(leave.AdminRemarks))
                                            {
                                                <div class="small text-muted" style="font-size: 0.75rem;">Remarks: @leave.AdminRemarks</div>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (leave.Status == "Pending")
                                        {
                                            <div class="d-flex gap-1">
                                                <!-- Approve Modal Trigger -->
                                                <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#approveModal-@leave.LeaveId">
                                                    Approve
                                                </button>
                                                <!-- Reject Modal Trigger -->
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@leave.LeaveId">
                                                    Reject
                                                </button>
                                            </div>

                                            <!-- Approve Modal -->
                                            <div class="modal fade" id="approveModal-@leave.LeaveId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        @using (Html.BeginForm("Approve", "Leave", FormMethod.Post))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="leaveId" value="@leave.LeaveId" />
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fw-bold">Approve Leave Request</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p>Are you sure you want to approve <strong>@leave.TotalDays working day(s)</strong> leave for <strong>@leave.EmployeeName</strong> (@leave.FormattedStartDate to @leave.FormattedEndDate)?</p>
                                                                <div class="mb-3">
                                                                    <label class="form-label small">Approval Remarks (Optional)</label>
                                                                    <input type="text" name="adminRemarks" class="form-control" placeholder="e.g. Approved as per project availability" maxlength="250" />
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-success btn-sm">Confirm Approval</button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Reject Modal -->
                                            <div class="modal fade" id="rejectModal-@leave.LeaveId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        @using (Html.BeginForm("Reject", "Leave", FormMethod.Post))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="leaveId" value="@leave.LeaveId" />
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fw-bold text-danger">Reject Leave Request</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p>Provide a reason for rejecting <strong>@leave.EmployeeName</strong>'s leave request:</p>
                                                                <div class="mb-3">
                                                                    <label class="form-label small text-danger">Rejection Reason / Remarks (Required)</label>
                                                                    <input type="text" name="adminRemarks" class="form-control" placeholder="e.g. Critical release deadline" required maxlength="250" />
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-danger btn-sm">Confirm Rejection</button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Decided by @leave.DecidedByUsername</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    No leave requests match the criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
