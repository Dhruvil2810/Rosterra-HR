@model IEnumerable<ROSTERRA_HR.Models.Shift>

@{
    ViewBag.Title = "Shift Management";
}

<div class="container py-2">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h2 class="h3 fw-bold mb-1 text-dark">Shift Management</h2>
            <p class="text-muted mb-0 small">Define workplace schedules, operational hours, and employee shift assignments.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Assign", "Shift")" class="btn btn-outline-primary">
                &#128101; Assign Shift to Employee
            </a>
            <a href="@Url.Action("Create", "Shift")" class="btn btn-primary shadow-sm">
                + Create New Shift
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>&#10004; Success:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Shifts Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-secondary">
                        <tr>
                            <th class="ps-3">SHIFT NAME</th>
                            <th>START TIME</th>
                            <th>END TIME</th>
                            <th>HOURS</th>
                            <th>DESCRIPTION</th>
                            <th>STATUS</th>
                            <th class="text-end pe-3">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shift in Model)
                        {
                            double hours = (shift.EndTime - shift.StartTime).TotalHours;
                            if (hours < 0) { hours += 24; } // overnight shift

                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@shift.ShiftName</div>
                                    <small class="text-muted">ID: #@shift.ShiftId</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-primary border fs-6">
                                        &#9200; @shift.FormattedStartTime
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-danger border fs-6">
                                        &#9200; @shift.FormattedEndTime
                                    </span>
                                </td>
                                <td class="fw-semibold">
                                    @hours.ToString("0.##") hrs / day
                                </td>
                                <td class="text-muted small">
                                    @(string.IsNullOrWhiteSpace(shift.Description) ? "No notes" : shift.Description)
                                </td>
                                <td>
                                    @if (shift.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a href="@Url.Action("Edit", "Shift", new { id = shift.ShiftId })" class="btn btn-sm btn-outline-secondary">
                                        &#9998; Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
