@{
    ViewBag.Title = "HR Dashboard - Rosterra HR";
}

<div class="container py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h2 class="h3 fw-bold mb-1 text-dark">Welcome, @(Session["Username"] ?? "HR Admin")</h2>
            <p class="text-muted mb-0 small">Human Resource &amp; Workforce Management Workspace &bull; Session Active</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger btn-sm">
                &#x21FD; Sign Out
            </a>
        </div>
    </div>

    <!-- Quick Workforce Operations Modules -->
    <div class="row g-4 mb-4">
        <!-- Employees -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-primary">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-1 text-primary">&#128101;</span>
                            <span class="badge bg-primary">Core</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Employee Directory</h5>
                        <p class="text-muted small mb-3">
                            Register new hires, generate employee login credentials, edit profiles, and manage active status.
                        </p>
                    </div>
                    <div class="d-grid">
                        <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-primary btn-sm fw-semibold">
                            Manage Employees &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Shift System -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-info">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-1 text-info">&#9200;</span>
                            <span class="badge bg-info text-dark">Schedules</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Shift Management</h5>
                        <p class="text-muted small mb-3">
                            Create custom operating shifts (Morning, Afternoon, Evening, Night) and assign them to employees.
                        </p>
                    </div>
                    <div class="d-grid">
                        <a href="@Url.Action("Index", "Shift")" class="btn btn-outline-info btn-sm text-dark fw-semibold">
                            Configure Shifts &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Attendance Roster -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-success">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-1 text-success">&#128197;</span>
                            <span class="badge bg-success">Daily</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Attendance Monitor</h5>
                        <p class="text-muted small mb-3">
                            Day-wise arrival/departure punch monitoring, on-time vs late calculation, and overnight shift tracking.
                        </p>
                    </div>
                    <div class="d-grid">
                        <a href="@Url.Action("Index", "Attendance")" class="btn btn-outline-success btn-sm fw-semibold">
                            Attendance Roster &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Leave Management -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-warning">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-1 text-warning">&#128221;</span>
                            <span class="badge bg-warning text-dark">Approvals</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Leave Management</h5>
                        <p class="text-muted small mb-3">
                            Review employee time-off requests with automatic Sunday exclusion, conflict detection, and approve/reject workflows.
                        </p>
                    </div>
                    <div class="d-grid">
                        <a href="@Url.Action("Index", "Leave")" class="btn btn-outline-warning btn-sm text-dark fw-semibold">
                            Review Leave Requests &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payroll Management -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-danger">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-1 text-danger">&#128181;</span>
                            <span class="badge bg-danger">Finance</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Payroll &amp; Compensation</h5>
                        <p class="text-muted small mb-3">
                            Generate monthly payroll runs, compute attendance-based Loss of Pay (LOP), configure salary structures, and issue payslips.
                        </p>
                    </div>
                    <div class="d-grid">
                        <a href="@Url.Action("Index", "Payroll")" class="btn btn-outline-danger btn-sm fw-semibold">
                            Open Payroll Hub &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
