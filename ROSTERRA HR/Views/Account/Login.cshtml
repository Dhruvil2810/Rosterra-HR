@model ROSTERRA_HR.Models.LoginViewModel

@{
    ViewBag.Title = "HR Login";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card login-card shadow-sm border-0 mt-4">
            <div class="card-header bg-primary text-white text-center py-3 rounded-top">
                <h4 class="mb-0 fw-bold">Rosterra HR</h4>
                <small class="text-white-50">Workforce Management System &bull; Portal Access</small>
            </div>
            <div class="card-body p-4 bg-white">
                <h5 class="card-title text-center mb-4 text-secondary">Sign in to your account</h5>

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "needs-validation", role = "form", autocomplete = "off" }))
                {
                    @Html.AntiForgeryToken()

                    if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                    {
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })
                    }

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">&#128100;</span>
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Enter your username", autofocus = "autofocus" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">&#128274;</span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">Sign In</button>
                    </div>
                }
            </div>
            <div class="card-footer bg-light text-center py-3 text-muted small">
                Protected administrative portal &bull; Authorized personnel only
            </div>
        </div>
    </div>
</div>
