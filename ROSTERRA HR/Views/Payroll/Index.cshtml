@model ROSTERRA_HR.Models.HRPayrollIndexViewModel

@{
    ViewBag.Title = "Payroll Management";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h2 class="h3 fw-bold mb-1 text-dark">Payroll Management</h2>
            <p class="text-muted mb-0 small">Generate monthly compensation runs, compute attendance deductions (Loss of Pay), and review payslips.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("SalaryStructures", "Payroll")" class="btn btn-outline-primary btn-sm">
                &#9881; Salary Structures
            </a>
            <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary btn-sm">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>&#10004; Success:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>&#9888; Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-primary">
                <div class="text-muted small">Total Disbursed</div>
                <div class="h3 fw-bold text-primary mb-0">@Model.TotalDisbursed.ToString("C")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-info">
                <div class="text-muted small">Processed Employees</div>
                <div class="h3 fw-bold text-dark mb-0">@Model.TotalEmployeesProcessed</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-success">
                <div class="text-muted small">Disbursed (Paid)</div>
                <div class="h3 fw-bold text-success mb-0">@Model.PaidCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-warning">
                <div class="text-muted small">Pending Disbursal</div>
                <div class="h3 fw-bold text-warning mb-0">@Model.PendingCount</div>
            </div>
        </div>
    </div>

    <!-- Month Selector & Generation Card -->
    <div class="card border-0 shadow-sm bg-white mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <form method="get" action="@Url.Action("Index", "Payroll")" class="d-flex align-items-center gap-2">
                    <label class="small text-muted fw-semibold">Payroll Period:</label>
                    <select name="month" class="form-select form-select-sm" style="width: auto;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" @(Model.SelectedMonth == m ? "selected" : "")>
                                @(new DateTime(2026, m, 1).ToString("MMMM"))
                            </option>
                        }
                    </select>
                    <select name="year" class="form-select form-select-sm" style="width: auto;">
                        @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                        {
                            <option value="@y" @(Model.SelectedYear == y ? "selected" : "")>@y</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm">Load Period</button>
                </form>

                <div>
                    @using (Html.BeginForm("Generate", "Payroll", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="month" value="@Model.SelectedMonth" />
                        <input type="hidden" name="year" value="@Model.SelectedYear" />
                        <button type="submit" class="btn btn-success btn-sm fw-semibold" onclick="return confirm('Recalculate and generate payroll for this period using current attendance and leave records?');">
                            &#9874; Generate / Recalculate Payroll
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Payroll Records Table -->
    <div class="card border-0 shadow-sm bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                Compensation Breakdown &mdash; @(new DateTime(Model.SelectedYear, Model.SelectedMonth, 1).ToString("MMMM yyyy"))
            </h5>
            <small class="text-muted">Loss of Pay automatically computed from Attendance absences</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Days (Work / Pres / Abs)</th>
                            <th>Gross Salary</th>
                            <th>Standard Deductions</th>
                            <th>Loss of Pay (LOP)</th>
                            <th>Net Salary</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PayrollRecords != null && Model.PayrollRecords.Any())
                        {
                            foreach (var item in Model.PayrollRecords)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@item.EmployeeName</div>
                                        <small class="text-muted">@item.Position</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.Department</span>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <strong>@item.TotalWorkingDays</strong> work days &bull; 
                                            <span class="text-success fw-semibold">@item.PresentDays pres</span> &bull; 
                                            <span class="text-danger fw-semibold">@item.AbsentDays abs</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.GrossSalary.ToString("C")</div>
                                        <small class="text-muted">Basic: @item.BasicSalary.ToString("C")</small>
                                    </td>
                                    <td>@item.StandardDeductions.ToString("C")</td>
                                    <td>
                                        @if (item.LossOfPay > 0)
                                        {
                                            <span class="text-danger fw-semibold">-@item.LossOfPay.ToString("C")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">₹0.00</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fs-6 fw-bold text-primary">@item.NetSalary.ToString("C")</div>
                                    </td>
                                    <td>
                                        @if (item.Status == "Paid")
                                        {
                                            <span class="badge bg-success">Paid</span>
                                            <div class="small text-muted" style="font-size: 0.75rem;">@item.FormattedPaymentDate</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Generated</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a href="@Url.Action("Payslip", "Payroll", new { id = item.PayrollId })" class="btn btn-outline-primary btn-sm" target="_blank">
                                                &#128196; Payslip
                                            </a>
                                            @if (item.Status != "Paid")
                                            {
                                                using (Html.BeginForm("MarkPaid", "Payroll", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="payrollId" value="@item.PayrollId" />
                                                    <input type="hidden" name="month" value="@item.Month" />
                                                    <input type="hidden" name="year" value="@item.Year" />
                                                    <button type="submit" class="btn btn-outline-success btn-sm">
                                                        Mark Paid
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    No payroll records generated for @(new DateTime(Model.SelectedYear, Model.SelectedMonth, 1).ToString("MMMM yyyy")) yet.<br />
                                    Click <strong>"Generate / Recalculate Payroll"</strong> above to run this month's calculation.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
