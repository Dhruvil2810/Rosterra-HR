@model ROSTERRA_HR.Models.EmployeeCreateViewModel

@{
    ViewBag.Title = "Register Employee";
}

<div class="container py-2">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                <div>
                    <h2 class="h3 fw-bold mb-1 text-dark">Register New Employee</h2>
                    <p class="text-muted mb-0 small">Create employee workforce record and automatically provision portal login credentials.</p>
                </div>
                <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-secondary btn-sm">
                    &larr; Back to Directory
                </a>
            </div>

            <!-- Registration Form Card -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    @using (Html.BeginForm("Create", "Employee", FormMethod.Post, new { @class = "needs-validation", role = "form", autocomplete = "off" }))
                    {
                        @Html.AntiForgeryToken()

                        if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                        {
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })
                        }

                        <!-- Section 1: Personal Details -->
                        <h5 class="fw-bold text-primary mb-3">1. Personal &amp; Contact Details</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.FirstName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "e.g. John", autofocus = "autofocus" })
                                @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.LastName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "e.g. Doe" })
                                @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "john.doe@company.com", type = "email" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "e.g. +1 555-0199" })
                                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                        </div>

                        <!-- Section 2: Employment Information -->
                        <h5 class="fw-bold text-primary mb-3">2. Employment &amp; Compensation</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Department, new { @class = "form-label" })
                                <select name="Department" class="form-select">
                                    <option value="">-- Select Department --</option>
                                    <option value="Engineering" selected="@(Model.Department == "Engineering")">Engineering</option>
                                    <option value="Human Resources" selected="@(Model.Department == "Human Resources")">Human Resources</option>
                                    <option value="Finance" selected="@(Model.Department == "Finance")">Finance</option>
                                    <option value="Sales & Marketing" selected="@(Model.Department == "Sales & Marketing")">Sales & Marketing</option>
                                    <option value="Operations" selected="@(Model.Department == "Operations")">Operations</option>
                                </select>
                                @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Position, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Position, new { @class = "form-control", placeholder = "e.g. Software Engineer" })
                                @Html.ValidationMessageFor(m => m.Position, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Salary, new { @class = "form-label" })
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    @Html.TextBoxFor(m => m.Salary, new { @class = "form-control", placeholder = "0.00", type = "number", step = "0.01" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Salary, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.HireDate, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.HireDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(m => m.HireDate, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.ShiftId, new { @class = "form-label" })
                                @Html.DropDownListFor(m => m.ShiftId, (SelectList)ViewBag.Shifts, "-- Select Work Shift --", new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.ShiftId, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                        </div>

                        <!-- Section 3: Portal Login Credentials -->
                        <div class="bg-light p-3 rounded mb-4 border">
                            <h5 class="fw-bold text-dark mb-1">3. Employee Portal Login Provisioning</h5>
                            <p class="text-muted small mb-3">These credentials allow the employee to log in to their self-service dashboard.</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                                    <div class="input-group">
                                        <span class="input-group-text bg-white">&#128100;</span>
                                        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "e.g. jdoe" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                                    <div class="input-group">
                                        <span class="input-group-text bg-white">&#128274;</span>
                                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Initial password" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">Save &amp; Create Account</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
