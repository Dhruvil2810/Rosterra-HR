@model IEnumerable<ROSTERRA_HR.Models.Employee>

@{
    ViewBag.Title = "Employee Directory";
}

<div class="container py-2">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h2 class="h3 fw-bold mb-1 text-dark">Employee Management</h2>
            <p class="text-muted mb-0 small">Directory, registration, and status management &bull; ADO.NET Data Engine</p>
        </div>
        <div>
            <a href="@Url.Action("Create", "Employee")" class="btn btn-primary shadow-sm">
                + Register New Employee
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>&#10004; Success:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body p-3">
            @using (Html.BeginForm("Index", "Employee", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
            {
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted">&#128269;</span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, email, or designation..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="department" class="form-select">
                        <option value="All" selected="@(ViewBag.Department == null || ViewBag.Department == "All")">All Departments</option>
                        <option value="Engineering" selected="@(ViewBag.Department == "Engineering")">Engineering</option>
                        <option value="Human Resources" selected="@(ViewBag.Department == "Human Resources")">Human Resources</option>
                        <option value="Finance" selected="@(ViewBag.Department == "Finance")">Finance</option>
                        <option value="Sales & Marketing" selected="@(ViewBag.Department == "Sales & Marketing")">Sales & Marketing</option>
                        <option value="Operations" selected="@(ViewBag.Department == "Operations")">Operations</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="status" class="form-select">
                        <option value="" selected="@(ViewBag.Status == null)">All Statuses</option>
                        <option value="true" selected="@(ViewBag.Status != null && (bool)ViewBag.Status == true)">Active Only</option>
                        <option value="false" selected="@(ViewBag.Status != null && (bool)ViewBag.Status == false)">Inactive Only</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-dark flex-grow-1">Filter</button>
                    @if (!string.IsNullOrEmpty(ViewBag.Search) || (ViewBag.Department != null && ViewBag.Department != "All") || ViewBag.Status != null)
                    {
                        <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-secondary" title="Reset Filters">&#10006;</a>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Employee Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <div class="fs-1 text-secondary mb-2">&#128101;</div>
                    <h5>No employees found matching the specified criteria.</h5>
                    <p class="small mb-3">Try adjusting your search terms or register a new employee.</p>
                    <a href="@Url.Action("Create", "Employee")" class="btn btn-sm btn-primary">+ Register First Employee</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small">
                            <tr>
                                <th class="ps-3">EMPLOYEE</th>
                                <th>DEPARTMENT &amp; ROLE</th>
                                <th>CONTACT</th>
                                <th>SALARY</th>
                                <th>HIRED</th>
                                <th>STATUS</th>
                                <th class="text-end pe-3">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model)
                            {
                                <tr class="@(emp.IsActive ? "" : "table-light text-muted")">
                                    <td class="ps-3">
                                        <div class="fw-bold text-dark">@emp.FullName</div>
                                        <small class="text-muted">Username: <code>@emp.Username</code></small>
                                    </td>
                                    <td>
                                        <div><span class="badge bg-light text-dark border">@emp.Department</span></div>
                                        <small class="text-muted">@emp.Position</small>
                                    </td>
                                    <td>
                                        <div><a href="mailto:@emp.Email" class="text-decoration-none small">@emp.Email</a></div>
                                        <small class="text-muted">@(string.IsNullOrWhiteSpace(emp.PhoneNumber) ? "-" : emp.PhoneNumber)</small>
                                    </td>
                                    <td class="fw-semibold text-dark">
                                        $@emp.Salary.ToString("N2")
                                    </td>
                                    <td class="small text-muted">
                                        @emp.HireDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        @if (emp.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", "Employee", new { id = emp.EmployeeId })" class="btn btn-outline-secondary" title="View Details">
                                                &#128065; View
                                            </a>
                                            <a href="@Url.Action("Edit", "Employee", new { id = emp.EmployeeId })" class="btn btn-outline-primary" title="Edit">
                                                &#9998; Edit
                                            </a>
                                            @using (Html.BeginForm("ToggleStatus", "Employee", new { id = emp.EmployeeId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Are you sure you want to " + (emp.IsActive ? "deactivate" : "activate") + " " + emp.FullName + "?');" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-@(emp.IsActive ? "warning" : "success")" title="@(emp.IsActive ? "Deactivate" : "Activate")">
                                                    @(emp.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
