<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Rosterra HR</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous" />
    <!-- Application Stylesheet -->
    <link href="~/Content/site.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Dashboard")">
                    <span class="text-primary">&#9670;</span> ROSTERRA <span class="badge bg-primary text-light fs-6">HR</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rosterraNavbar" aria-controls="rosterraNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="rosterraNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (Session["Role"] != null && string.Equals(Session["Role"].ToString(), "HR", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Dashboard")">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Employee")">Employees</a>
                            </li>
                        }
                        else if (Session["Role"] != null && string.Equals(Session["Role"].ToString(), "Employee", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "EmployeeDashboard")">My Portal</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        @if (Session["Username"] != null)
                        {
                            <span class="text-light me-3 small">
                                Signed in as <strong class="text-warning">@Session["Username"]</strong>
                                <span class="badge bg-secondary ms-1">@Session["Role"]</span>
                            </span>
                            <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger btn-sm">
                                Logout
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-sm">
                                Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
        <div class="container">
            &copy; @DateTime.UtcNow.Year - <strong>Rosterra HR</strong> &bull; Enterprise Workforce Management
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
